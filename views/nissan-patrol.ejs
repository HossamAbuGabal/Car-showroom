<body class="bg-gray-100">

   <header id="main-header">

        <%- include('partials/navbar.ejs') %>
        <div class="search-box container">
            <input type="search" name="" placeholder="Search...">
        </div>
    </header>
    
     <script>
    let lastScrollTop = 0;
    const header = document.getElementById("main-header");

    window.addEventListener("scroll", function() {
        let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

        if (scrollTop > lastScrollTop) {
            // Scrolling down
            header.style.top = "-100px";
        } else {
            // Scrolling up
            header.style.top = "0";
        }

        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
    });
</script>
         
<section class="product-detail-section">
    <div class="product-detail-container">
        <div class="product-image-container">
            <div class="product-image" style="background-image: url('https://carsguide-res.cloudinary.com/image/upload/f_auto,fl_lossy,q_auto,t_default/v1/editorial/segment_review/hero_image/2024-Nissan-Patrol-Warrior-Ti-SUV-Grey-MO-1001x565-(1).jpg');"></div>
