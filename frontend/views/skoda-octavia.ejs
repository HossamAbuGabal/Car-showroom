<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CarLuck - Skoda Octavia VRS</title>
  <link rel="stylesheet" href="../css/homepage.css" />
  <link rel="stylesheet" href="../css/product-page.css" />
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
</head>
<body class="bg-gray-100">

  <header id="main-header">

        <%- include('navbar.ejs') %>
        <div class="search-box container">
            <input type="search" name="" placeholder="Search...">
        </div>
    </header>
    
     <script>
    let lastScrollTop = 0;
    const header = document.getElementById("main-header");

    window.addEventListener("scroll", function() {
        let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

        if (scrollTop > lastScrollTop) {
            // Scrolling down
            header.style.top = "-100px";
        } else {
            // Scrolling up
            header.style.top = "0";
        }

        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
    });
</script>
         
<section class="product-detail-section">
    <div class="product-detail-container">
        <div class="product-image-container">
            <div class="product-image" style="background-image: url('https://motorlease.azureedge.net/umbraco-media-cache/1/b/f/8/5/e/1bf85e5185cd1d831a92784aae638398651c6062.jpg');"></div>
        </div>
        <div class="product-info-container">
            <h1 class="product-title">Skoda Octavia VRS</h1>
            <div class="product-specs">
                <div class="spec-item">
                    <span class="spec-label">Engine:</span>
                    <span class="spec-value">2.0L Turbo I4</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label">Horsepower:</span>
                    <span class="spec-value">245 HP</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label">0-60 mph:</span>
                    <span class="spec-value">6.5s</span>
                </div>
                <div class="spec-item">
                    <span class="spec-label">Transmission:</span>
                    <span class="spec-value">7-Speed DSG</span>
                </div>
            </div>
            <p class="product-description">The Skoda Octavia VRS combines practicality with performance, offering sporty handling and ample space. With its aggressive styling and efficient turbocharged engine, it delivers an engaging driving experience without compromising on comfort.</p>
            <div class="product-price-container">
                <span class="price">$38,000</span>
                <span class="price-note">+ Tax & Fees</span>
            </div>
            <button class="product-cta">Inquire Now</button>
        </div>
    </div>
</section>


