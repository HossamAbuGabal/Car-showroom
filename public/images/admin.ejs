<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - CarLuck</title>
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/homepage.css">
    <style>
        .admin-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 2rem;
            background: var(--bg-color);
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .admin-header {
            text-align: center;
            margin-bottom: 2rem;
            color: var(--main-color);
        }
        .admin-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        .stat-card {
            background: var(--container-color);
            padding: 1.5rem;
            border-radius: 8px;
            text-align: center;
            border: 2px solid var(--main-color);
        }
        .stat-card h3 {
            color: var(--main-color);
            margin-bottom: 0.5rem;
        }
        .stat-card p {
            font-size: 2rem;
            font-weight: bold;
            color: var(--text-color);
        }
        .welcome-message {
            background: var(--container-color);
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            border-left: 4px solid var(--main-color);
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    
    <div class="admin-container">
        <div class="welcome-message">
            <h2>Welcome, <%= user.firstName %> <%= user.lastName %></h2>
            <p>Admin Dashboard - Manage your Car Showroom</p>
        </div>

        <div class="admin-header">
            <h1><i class='bx bx-shield-check'></i> Admin Dashboard</h1>
            <p>Manage users, vehicles, and system settings</p>
        </div>

        <div class="admin-stats">
            <div class="stat-card">
                <h3><i class='bx bx-user'></i> Total Users</h3>
                <p>Loading...</p>
            </div>
            <div class="stat-card">
                <h3><i class='bx bx-car'></i> Total Vehicles</h3>
                <p>10</p>
            </div>
            <div class="stat-card">
                <h3><i class='bx bx-message'></i> Contact Messages</h3>
                <p>Loading...</p>
            </div>
            <div class="stat-card">
                <h3><i class='bx bx-heart'></i> Total Favorites</h3>
                <p>Loading...</p>
            </div>
        </div>
    </div>
</body>
</html>
