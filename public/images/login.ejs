<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>CarLuck - Login</title>

  <!-- Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

  <!-- Custom Styles -->
  <link rel="stylesheet" href="../css/login.css" />
</head>
<body>
  <div class="container">
    <div class="form-container">
      <!-- Logo/Brand -->
      <div class="brand">
        <i class='bx bx-car'></i>
        <h1>CarLuck</h1>
        <p>Your journey starts here</p>
      </div>

      <!-- Tabs -->
      <div class="tabs">
        <button id="loginTab" class="tab-btn active">
          <i class='bx bx-log-in'></i>
          Login
        </button>
        <button id="signupTab" class="tab-btn">
          <i class='bx bx-user-plus'></i>
          Sign Up
        </button>
      </div>

      <!-- Login Form -->
      <form id="loginForm" class="form">
        <div class="form-group">
          <label for="loginEmail">Email</label>
          <div class="input-group">
            <i class='bx bx-envelope'></i>
            <input type="email" id="loginEmail" placeholder="Enter your email" required>
          </div>
        </div>
        
        <div class="form-group">
          <label for="loginPassword">Password</label>
          <div class="input-group">
            <i class='bx bx-lock-alt'></i>
            <input type="password" id="loginPassword" placeholder="Enter your password" required>
            <button type="button" class="toggle-password" onclick="togglePassword('loginPassword')">
              <i class='bx bx-show'></i>
            </button>
          </div>
        </div>

        <div class="form-options">
          <label class="checkbox-container">
            <input type="checkbox" id="rememberMe">
            <span class="checkmark"></span>
            Remember me
          </label>
          <a href="#" class="forgot-password">Forgot password?</a>
        </div>

        <button type="submit" class="submit-btn">
          <span>Login</span>
          <i class='bx bx-right-arrow-alt'></i>
        </button>
      </form>

      <!-- Signup Form -->
      <form id="signupForm" class="form hidden">
        <div class="form-row">
          <div class="form-group">
            <label for="signupFirstName">First Name</label>
            <div class="input-group">
              <i class='bx bx-user'></i>
              <input type="text" id="signupFirstName" placeholder="First name" required>
            </div>
          </div>
          
          <div class="form-group">
            <label for="signupLastName">Last Name</label>
            <div class="input-group">
              <i class='bx bx-user'></i>
              <input type="text" id="signupLastName" placeholder="Last name" required>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label for="signupEmail">Email</label>
          <div class="input-group">
            <i class='bx bx-envelope'></i>
            <input type="email" id="signupEmail" placeholder="Enter your email" required>
          </div>
        </div>

        <div class="form-group">
          <label for="signupPhone">Phone Number</label>
          <div class="input-group">
            <i class='bx bx-phone'></i>
            <input type="tel" id="signupPhone" placeholder="Enter your phone number" required>
          </div>
        </div>
        
        <div class="form-group">
          <label for="signupPassword">Password</label>
          <div class="input-group">
            <i class='bx bx-lock-alt'></i>
            <input type="password" id="signupPassword" placeholder="Create a password" required>
            <button type="button" class="toggle-password" onclick="togglePassword('signupPassword')">
              <i class='bx bx-show'></i>
            </button>
          </div>
          <small class="password-hint">Password must be at least 6 characters long</small>
        </div>

        <div class="form-options">
          <label class="checkbox-container">
            <input type="checkbox" id="agreeTerms" required>
            <span class="checkmark"></span>
            I agree to the <a href="#" class="terms-link">Terms & Conditions</a>
          </label>
        </div>

        <button type="submit" class="submit-btn">
          <span>Create Account</span>
          <i class='bx bx-right-arrow-alt'></i>
        </button>
      </form>

      <!-- Loading Spinner -->
      <div id="loadingSpinner" class="loading-spinner hidden">
        <div class="spinner"></div>
        <p>Please wait...</p>
      </div>

      <!-- Error/Success Messages -->
      <div id="messageContainer" class="message-container hidden">
        <div class="message-content">
          <i class='bx'></i>
          <span id="messageText"></span>
        </div>
      </div>
    </div>

    <!-- Background Decoration -->
    <div class="bg-decoration">
      <div class="car-silhouette"></div>
      <div class="floating-elements">
        <div class="element element-1"></div>
        <div class="element element-2"></div>
        <div class="element element-3"></div>
      </div>
    </div>
  </div>

  <!-- JS Logic -->
  <script src="../js/login.js"></script>
</body>
</html>