<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>CarLuck - Login / Signup</title>

  <!-- Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />

  <!-- Custom Styles -->
  <link rel="stylesheet" href="../css/login.css" />
</head>
<body>

  <div class="container">
    <!-- Tabs -->
    <div class="tabs">
      <button id="loginTab" class="<%= (typeof tab !== 'undefined' && tab === 'login') ? 'active' : '' %>">Login</button>
      <button id="signupTab" class="<%= (typeof tab !== 'undefined' && tab === 'signup') ? 'active' : '' %>">Signup</button>
    </div>

    <!-- Login Form -->
    <form id="loginForm" class="form <%= (typeof tab !== 'undefined' && tab === 'signup') ? 'hidden' : '' %>">
      <label>Email</label>
      <input id="loginEmail" type="email" placeholder="you@example.com" required>
      <label>Password</label>
      <input id="loginPassword" type="password" placeholder="••••••••" required 
        pattern="^(?=.*[0-9])(?=.*[!@#$%^&*])[A-Za-z0-9!@#$%^&*]{8,}$"
        title="Password must be at least 8 characters, contain at least one number and one special character.">
      <button type="submit">Login</button>
    </form>

    <!-- Signup Form -->
    <form id="signupForm" class="form <%= (typeof tab === 'undefined' || tab === 'login') ? 'hidden' : '' %>">
      <label>First name</label>
      <input id="firstName" type="text" placeholder="First name" required>

      <label>Last name</label>
      <input id="lastName" type="text" placeholder="Last name" required>

      <label>Email</label>
      <input id="signupEmail" type="email" placeholder="you@example.com" required>

      <label>Phone number</label>
      <div style="display: flex; gap: 8px;">
        <select id="countryCode" required>
          <option value="+20">🇪🇬 Egypt (+20)</option>
          <option value="+1">🇺🇸 USA (+1)</option>
          <option value="+44">🇬🇧 UK (+44)</option>
          <option value="+91">🇮🇳 India (+91)</option>
          <option value="+971">🇦🇪 UAE (+971)</option>
        </select>
        <input id="phoneNumber" type="tel" placeholder="e.g. 5551234567" required 
          pattern="^\d{7,15}$"
          title="Phone number must be between 7 and 15 digits long.">
      </div>

      <label>Password</label>
      <input id="signupPassword" type="password" placeholder="Create a password" required 
        pattern="^(?=.*[0-9])(?=.*[!@#$%^&*])[A-Za-z0-9!@#$%^&*]{8,}$"
        title="Password must be at least 8 characters, contain at least one number and one special character.">

      <label>User type</label>
      <select id="userType" required>
        <option value="Customer">Customer</option>
        <option value="Business">Business</option>
      </select>

      <button type="submit">Create account</button>
    </form>
  </div>

  <!-- JS Logic -->
  <script src="../js/login.js"></script>
</body>
</html>
