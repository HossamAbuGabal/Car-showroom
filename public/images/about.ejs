<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us - CarLuck</title>
  <link rel="stylesheet" href="/css/homepage.css" />
  <link href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
  <style>
    /* Your extra styles stay here */
    .profile-dropdown { position: relative; display: inline-block; }
    .profile-dropdown-content {
        display: none;
        position: absolute;
        background-color: #333;
        min-width: 200px;
        box-shadow: 0px 8px 16px rgba(0,0,0,0.2);
        z-index: 1; right: 0; border-radius: 5px; padding: 10px;
        border: 1px solid var(--main-color);
    }
    .profile-dropdown-content a, .profile-dropdown-content div {
        color: var(--text-color); padding: 8px 12px; text-decoration: none; display: block; font-size: 0.9rem;
    }
    .profile-dropdown-content p { font-size: 0.8rem; color: #ccc; }
    .profile-dropdown-content .divider { height: 1px; background-color: #555; margin: 8px 0; }
    .profile-dropdown-content a:hover { background-color: var(--main-color); color: var(--text-color); }
    .profile-dropdown:hover .profile-dropdown-content { display: block; }
    .profile-icon { cursor: pointer; }


    /* About Page Specific Styles */
    .about-main {
      padding-top: 6rem;
      background-color: #111;
      min-height: 100vh;
       color: var(--text-color);
    }
    
    .about-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }
    
    .about-header {
      text-align: center;
      margin-bottom: 3rem;
    }
    
    .about-header h1 {
      font-size: 2.5rem;
      color: var(--main-color);
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    
    .about-header p {
      font-size: 1.1rem;
      color: #bbb;
      max-width: 700px;
      margin: 0 auto;
    }
    
    .about-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      margin-bottom: 4rem;
      align-items: center;
    }
    
    .about-text h2 {
      font-size: 1.8rem;
      color: var(--text-color);
      margin-bottom: 1.5rem;
      position: relative;
    }
    
    .about-text h2::after {
      content: '';
      width: 60px;
      height: 3px;
      background-color: var(--main-color);
      display: block;
      margin: 0.8rem 0;
    }
    
    .about-text p {
      color: #bbb;
      line-height: 1.7;
      margin-bottom: 1.5rem;
      font-size: 1.05rem;
    }
    
    .values-list {
      margin-left: 0;
      padding-left: 0;
      color: #bbb;
      line-height: 1.7;
    }
    
    .values-list li {
      margin-bottom: 1.5rem;
      list-style: none;
      padding-left: 1.5rem;
      position: relative;
      font-size: 1.05rem;
    }
    
    .values-list li::before {
      content: '✓';
      color: var(--main-color);
      font-weight: bold;
      position: absolute;
      left: 0;
    }
    
    .value-title {
      color: var(--main-color);
      font-weight: bold;
      display: block;
      margin-bottom: 0.3rem;
      font-size: 1.1rem;
    }
    
    .about-image {
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 20px rgba(0,0,0,0.3);
      height: 400px;
      position: relative;
      background: url('https://images.hdqwalls.com/download/matt-black-bmw-m3-competition-gh-2880x1800.jpg') center/cover no-repeat;
    }
    
    .team-section {
      margin-top: 4rem;
    }
    
    .team-section h2 {
      text-align: center;
      font-size: 2rem;
      color: var(--main-color);
      margin-bottom: 3rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    
    .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }
    
    .team-member {
      background-color: #1a1a1a;
      border: 1px solid #222;
      border-radius: 12px;
      padding: 2rem;
      text-align: center;
      transition: all 0.3s ease;
    }
    
    .team-member:hover {
      transform: translateY(-5px);
      border-color: var(--main-color);
      box-shadow: 0 5px 15px rgba(102, 51, 153, 0.2);
    }
    
    .initial-circle {
      width: 80px;
      height: 80px;
      background-color: var(--main-color);
      color: var(--text-color);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      font-size: 1.8rem;
      font-weight: bold;
    }
    
    .team-member h3 {
      color: var(--text-color);
      margin-bottom: 0.5rem;
      font-size: 1.2rem;
    }
    
    .team-member p {
      color: #bbb;
      margin: 0.3rem 0;
    }
    
    .team-member p:last-child {
      font-style: italic;
      font-size: 0.9rem;
      margin-top: 0.8rem;
      color: #999;
    }
    
    @media (max-width: 768px) {
      .about-content {
        grid-template-columns: 1fr;
      }
      
      .about-image {
        height: 250px;
        order: -1;
      }
      
      .team-grid {
        grid-template-columns: 1fr;
        max-width: 400px;
        margin: 0 auto;
      }
    }
  </style>
</head>
<body class="bg-gray-100">
    <header id="main-header">
         <div class="nav container">
            <i class='bx bx-menu' id="menu-icon"></i>
            <a href="/" class="logo">Car<span>Luck</span></a>
            <ul class="navbar">
                <li><a href="/">Home</a></li>
                <li><a href="/vehicles">Vehicles</a></li>
                <li><a href="/Parts">Parts</a></li>
                <li><a href="/about" class="active">About</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/favorites">Favorites</a></li>
            </ul>
            <div class="nav-icons">
                <i class='bx bx-search' id="search-icon"></i>
                <div id="profile-section"></div>
            </div>
        </div>
        <div class="search-box container">
            <input type="search" placeholder="Search...">
        </div>
    </header>

  <script>
    let lastScrollTop = 0;
    const header = document.getElementById("main-header");

    window.addEventListener("scroll", function() {
        let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

        if (scrollTop > lastScrollTop) {
            // Scrolling down
            header.style.top = "-100px";
        } else {
            // Scrolling up
            header.style.top = "0";
        }

        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
    });
    </script>

