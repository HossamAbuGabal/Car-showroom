  <script>
    // Favorite star functionality for parts
    document.querySelectorAll('.product-card').forEach(card => {
      const favIcon = card.querySelector('.favorite-icon');
      const starIcon = favIcon.querySelector('i');
      const id = card.getAttribute('data-id');
      let favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
      // Set initial state
      if (favorites.includes(id)) {
        favIcon.classList.add('favorited');
        starIcon.classList.remove('bx-star');
        starIcon.classList.add('bxs-star');
      } else {
        favIcon.classList.remove('favorited');
        starIcon.classList.remove('bxs-star');
        starIcon.classList.add('bx-star');
      }
      favIcon.addEventListener('click', () => {
        let favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
        if (favorites.includes(id)) {
          favorites = favorites.filter(fav => fav !== id);
          favIcon.classList.remove('favorited');
          starIcon.classList.remove('bxs-star');
          starIcon.classList.add('bx-star');
        } else {
          favorites.push(id);
          favIcon.classList.add('favorited');
          starIcon.classList.remove('bx-star');
          starIcon.classList.add('bxs-star');
        }
        localStorage.setItem('favorites', JSON.stringify(favorites));
      });
    });
  </script>